<?xml version="1.0"?>
<package format="2">
  <name>rqt_udp_bridge</name>
  <version>0.0.0</version>
  <description>RQT interface to udp_bridge nodes.</description>

  <maintainer email="roland@ccom.unh.edu">Roland Arsenault</maintainer>

  <license>BSD</license>
  
  <buildtool_depend>ament_cmake_ros</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>qtbase5-dev</depend>
  <depend>rqt_gui_cpp</depend>
  <depend>rqt_gui</depend>
  <depend>udp_bridge_interfaces</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rqt_gui plugin="${prefix}/plugin.xml"/>
  </export>
</package>

